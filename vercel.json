    { "source": "/share/banner/:slug","destination": "https://tpthlopfhyuuspgooblk.supabase.co/functions/v1/og-share/banner/:slug" },
    { "source": "/share/page/:slug",  "destination": "https://tpthlopfhyuuspgooblk.supabase.co/functions/v1/og-share/page/:slug" },

