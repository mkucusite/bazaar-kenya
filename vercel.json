{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:js|css|woff2|png|jpg|webp|svg|ico))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/((?!assets/|api/|.*\\.(?:js|css|woff2|png|jpg|jpeg|webp|svg|ico|xml|txt|json|map)$).*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*\\.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(elections-2027|governors-2027|senators-2027|women-reps-2027|mps-2027|mca-2027|counties/.*|seats/.*|candidates/.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kenyaadverts.co.ke"
        }
      ],
      "destination": "https://www.kenyaadverts.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.kenyaadverts.co.ke"
        }
      ],
      "destination": "https://www.kenyaadverts.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kenyaadverts.com"
        }
      ],
      "destination": "https://www.kenyaadverts.com/:path*",
      "permanent": true
    },
    {
      "source": "/share/ad/:slug",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawl|spider|whatsapp|facebookexternalhit|twitterbot|telegrambot|linkedinbot|preview|google|bing|yahoo|slack|discord|chatgpt|gptbot|claude|anthropic|perplexity).*"
        }
      ],
      "destination": "https://www.kenyaadverts.com/ads/:slug",
      "permanent": false
    },
    {
      "source": "/share/blog/:slug",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawl|spider|whatsapp|facebookexternalhit|twitterbot|telegrambot|linkedinbot|preview|google|bing|yahoo|slack|discord|chatgpt|gptbot|claude|anthropic|perplexity).*"
        }
      ],
      "destination": "https://www.kenyaadverts.com/blog/:slug",
      "permanent": false
    },
    {
      "source": "/share/event/:slug",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawl|spider|whatsapp|facebookexternalhit|twitterbot|telegrambot|linkedinbot|preview|google|bing|yahoo|slack|discord|chatgpt|gptbot|claude|anthropic|perplexity).*"
        }
      ],
      "destination": "https://www.kenyaadverts.com/events/:slug",
      "permanent": false
    },
    {
      "source": "/share/banner/:slug",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawl|spider|whatsapp|facebookexternalhit|twitterbot|telegrambot|linkedinbot|preview|google|bing|yahoo|slack|discord|chatgpt|gptbot|claude|anthropic|perplexity).*"
        }
      ],
      "destination": "https://www.kenyaadverts.com/banners/:slug",
      "permanent": false
    },
    {
      "source": "/share/page/:slug",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawl|spider|whatsapp|facebookexternalhit|twitterbot|telegrambot|linkedinbot|preview|google|bing|yahoo|slack|discord|chatgpt|gptbot|claude|anthropic|perplexity).*"
        }
      ],
      "destination": "https://www.kenyaadverts.com/:slug",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api|_next|share/|og/|favicon\\.ico|favicon\\.png|robots\\.txt|sitemap\\.xml|sitemap-static\\.xml|sitemap-listings\\.xml|sitemap-blog\\.xml|sitemap-categories\\.xml|sitemap-events\\.xml|sitemap-banners\\.xml|sitemap-politics\\.xml|sitemap-elections\\.xml|sitemap-campaigns\\.xml|sitemap-business\\.xml|sitemap-parties\\.xml|sitemap-listings-index\\.xml|sitemap-listings-[^/]*\\.xml|sitemap-digital\\.xml|sitemap-[a-z-]+\\.xml|sitemap-directory\\.xml|sitemap-politicians\\.xml|llms\\.txt|og-image\\.png|pwa-icon-192\\.png|pwa-icon-512\\.png|placeholder\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}